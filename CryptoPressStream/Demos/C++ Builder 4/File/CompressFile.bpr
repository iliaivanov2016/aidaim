  -Od -Hc -H=$(BCB)\lib\vcl40.csm -w -Ve -r- -a8 -k -y -v -vi- -c -b- -w-par \
  -w-inl -Vx -tW -tWM -D$(SYSDEFINES);$(USERDEFINES)
IDLCFLAGS = -I..\..\..\current -I$(BCB)\include -I$(BCB)\include\vcl -I"s:\AidAim\CryptoPressStream\Lib\C++ Builder 4\"; -I"s:\AidAim\CryptoPressStream\Lib\C++ Builder 4\"; \
  -I..\..\..\..\Accuracer\Work_SQLMem -I..\..\..\Work -src_suffixcpp
