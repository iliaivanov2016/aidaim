  -$YD -$W -$O- -v -JPHNE -M
RFLAGS = -i..\..\..\current;$(BCB)\include;$(BCB)\include\vcl;"s:\AidAim\CryptoPressStream\Lib\C++ Builder 4\";"s:\AidAim\CryptoPressStream\Lib\C++ Builder 4\";..\..\..\..\Accuracer\Work_SQLMem;..\..\..\Work
AFLAGS = /i..\..\..\current /i$(BCB)\include /i$(BCB)\include\vcl /i"s:\AidAim\CryptoPressStream\Lib\C++ Builder 4\"; /i"s:\AidAim\CryptoPressStream\Lib\C++ Builder 4\"; \
  /i..\..\..\..\Accuracer\Work_SQLMem \
  /i"S:\Projects\Delphi Components\CryptoPressStream\Work" /mx /w2 /zd
LFLAGS = -Lc:\compilers\cbuilder4\lib\release\;c:\compilers\cbuilder4\projects\lib\;..\..\..\current;..\lib\release;$(BCB)\lib\obj;$(BCB)\lib;"s:\AidAim\CryptoPressStream\Lib\C++ Builder 4\";"s:\AidAim\CryptoPressStream\Lib\C++ Builder 4\";"E:\AidAim\Accuracer320_cs_pro.b4\Lib\C++ Builder 4\";..\..\..\..\Accuracer\Work_SQLMem;..\..\..\Work;$(RELEASELIBPATH) \
