package vclAccuracerd5;

{$R *.RES}
{$R 'ACRMain.dcr'}
{$ALIGN ON}
{$ASSERTIONS OFF}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Accuracer - Component'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

{$I ACRVer.Inc}

requires
  vcl50,
  Vcldb50;

contains
  ACRLocalEngine in 'ACRLocalEngine.pas',
  ACRMain in 'ACRMain.pas';

end.
