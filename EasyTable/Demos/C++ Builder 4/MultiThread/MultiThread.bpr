# ---------------------------------------------------------------------------
!if !$d(BCB)
BCB = $(MAKEDIR)\..
!endif

# ---------------------------------------------------------------------------
# IDE SECTION
# ---------------------------------------------------------------------------
# The following section of the project makefile is managed by the BCB IDE.
# It is recommended to use the IDE to change any of the values in this
# section.
# ---------------------------------------------------------------------------

VERSION = BCB.04.04
# ---------------------------------------------------------------------------
PROJECT = MultiThread.exe
OBJFILES = MultiThread.obj uMain.obj BkThread.obj
RESFILES = MultiThread.res
RESDEPEN = $(RESFILES) uMain.dfm
LIBFILES =
IDLGENFILES =
IDLFILES =
LIBRARIES = VCLX40.lib vcleasytableb4.lib Vcldb40.lib Vcl40.lib
SPARELIBS = Vcl40.lib Vcldb40.lib vcleasytableb4.lib VCLX40.lib
PACKAGES = Vcl40.bpi Vclx40.bpi vcljpg40.bpi Vcldb40.bpi
DEFFILE =
# ---------------------------------------------------------------------------
PATHCPP = .;
PATHPAS = .;
PATHASM = .;
PATHRC = .;
DEBUGLIBPATH = $(BCB)\lib\debug
RELEASELIBPATH = $(BCB)\lib\release
USERDEFINES =
SYSDEFINES = NO_STRICT
# ---------------------------------------------------------------------------
CFLAG1 = -If:\compilers\CBuilder4\Projects\;$(BCB)\include;$(BCB)\include\vcl;..\..\..\Work \
  -O2 -Hc -H=$(BCB)\lib\vcl40.csm -w -Ve -a8 -k- -vi -c -b- -w-par -w-inl -Vx -tW \
  -tWM -D$(SYSDEFINES);$(USERDEFINES)
IDLCFLAGS = -I"f:\compilers\CBuilder4\Projects\" -I$(BCB)\include -I$(BCB)\include\vcl \
  -I..\..\..\Work -src_suffixcpp
PFLAGS = -UF:\Compilers\CBuilder4\Projects\Lib\;$(BCB)\lib\debug;$(BCB)\lib\obj;$(BCB)\lib;..\..\..\Work;$(RELEASELIBPATH) \
  -If:\compilers\CBuilder4\Projects\;$(BCB)\include;$(BCB)\include\vcl;..\..\..\Work \
  -$Y- -$L- -$D- -v -JPHNE -M
RFLAGS = -if:\compilers\CBuilder4\Projects\;$(BCB)\include;$(BCB)\include\vcl;..\..\..\Work
AFLAGS = /if:\compilers\CBuilder4\Projects\ /i$(BCB)\include /i$(BCB)\include\vcl \
  /i..\..\..\Work /mx /w2 /zn
LFLAGS = -LF:\Compilers\CBuilder4\Projects\Lib\;$(BCB)\lib\debug;$(BCB)\lib\obj;$(BCB)\lib;..\..\..\Work;$(RELEASELIBPATH) \
  -aa -Tpe -x -Gn
# ---------------------------------------------------------------------------
ALLOBJ = c0w32.obj sysinit.obj $(OBJFILES)
ALLRES = $(RESFILES)
ALLLIB = $(LIBFILES) $(LIBRARIES) import32.lib cp32mt.lib
# ---------------------------------------------------------------------------
