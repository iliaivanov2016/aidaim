<?xml version='1.0' encoding='utf-8' ?>
<!-- C++Builder XML Project -->
<PROJECT>
  <MACROS>
    <VERSION value="BCB.06.00"/>
    <PROJECT value="dbftreeproc.exe"/>
    <OBJFILES value="dbftreeproc.obj Unitdbpc.obj"/>
    <RESFILES value="dbftreeproc.res"/>
    <IDLFILES value=""/>
    <IDLGENFILES value=""/>
    <DEFFILE value=""/>
    <RESDEPEN value="$(RESFILES) Unitdbpc.dfm"/>
    <LIBFILES value=""/>
    <LIBRARIES value="vclx.lib vcleasytableb4.lib TFLYTREEPRO.lib PLUGED.lib RAPID.lib 
      TRECOL.lib dbflytreepro.lib bdertl.lib vcldb.lib dbrtl.lib vcl.lib rtl.lib"/>
    <SPARELIBS value="rtl.lib vcl.lib dbrtl.lib vcldb.lib bdertl.lib dbflytreepro.lib TRECOL.lib 
      RAPID.lib PLUGED.lib TFLYTREEPRO.lib vcleasytableb4.lib vclx.lib"/>
    <PACKAGES value="rtl.bpi vcl.bpi vclx.bpi vcljpg.bpi bcbsmp.bpi qrpt.bpi dbrtl.bpi 
      vcldb.bpi bdertl.bpi ibsmp.bpi vcldbx.bpi teeui.bpi teedb.bpi tee.bpi 
