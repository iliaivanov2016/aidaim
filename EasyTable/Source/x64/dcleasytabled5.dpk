package dcleasytabled5;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'EasyTable Design-Time Package'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  Vcldb50,
  vcleasytabled5;

contains
  ETblEdit in 'ETblEdit.pas',
  ETblReg in 'ETblReg.pas',
  ETblFldLinks in 'ETblFldLinks.pas' {LinkFields};

end.
