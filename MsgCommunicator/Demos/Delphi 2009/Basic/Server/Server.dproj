                    <VersionInfo Name="Special">False</VersionInfo>
                    <VersionInfo Name="Private">False</VersionInfo>
                    <VersionInfo Name="DLL">False</VersionInfo>
                    <VersionInfo Name="Locale">1033</VersionInfo>
                    <VersionInfo Name="CodePage">1252</VersionInfo>
                </VersionInfo>
                <VersionInfoKeys>
                    <VersionInfoKeys Name="CompanyName">AidAim Software</VersionInfoKeys>
                    <VersionInfoKeys Name="FileDescription">Server: MsgCommunicator Demo. (c) 2004 - 2007 AidAim Software</VersionInfoKeys>
                    <VersionInfoKeys Name="FileVersion">3.0.0.0</VersionInfoKeys>
