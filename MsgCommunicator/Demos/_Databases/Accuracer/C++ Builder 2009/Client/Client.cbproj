			<BRCC_Defines>_RTLDLL;NO_STRICT;_VIS_NOLIB;$(BRCC_Defines)</BRCC_Defines>
			<PackageImports>rtl.bpi;vcl.bpi;vclx.bpi;vcljpg.bpi;dsnap.bpi;dbrtl.bpi;vcldb.bpi;bdertl.bpi;vclMsgComd12.bpi;vclAccuracerd12.bpi;MsgComDBACRd12.bpi</PackageImports>
			<ILINK_FullDebugInfo>true</ILINK_FullDebugInfo>
			<TASM_Defines>_RTLDLL;NO_STRICT;_VIS_NOLIB;$(TASM_Defines)</TASM_Defines>
