# ---------------------------------------------------------------------------
!if !$d(BCB)
BCB = $(MAKEDIR)\..
!endif

# ---------------------------------------------------------------------------
# IDE SECTION
# ---------------------------------------------------------------------------
# The following section of the project makefile is managed by the BCB IDE.
# It is recommended to use the IDE to change any of the values in this
# section.
# ---------------------------------------------------------------------------

VERSION = BCB.04.04
# ---------------------------------------------------------------------------
PROJECT = Client.exe
OBJFILES = Client.obj uStart.obj uFind.obj uHistory.obj uLogin.obj uMain.obj uRegister.obj
RESFILES = Client.res
RESDEPEN = $(RESFILES) uStart.dfm uFind.dfm uHistory.dfm uLogin.dfm uMain.dfm uRegister.dfm
LIBFILES =
IDLGENFILES =
IDLFILES =
LIBRARIES =
SPARELIBS = Vcl40.lib Vclx40.lib vclMsgComB4.lib VCLDB40.lib VCLACCURACERB4.lib
PACKAGES = Vcl40.bpi Vclx40.bpi vcljpg40.bpi   Vcldb40.bpi vclMsgComB4.bpi \
  vclAccuracerb4.bpi MsgComDBACRb4.bpi
DEFFILE =
# ---------------------------------------------------------------------------
PATHCPP = .;
PATHPAS = .;
PATHASM = .;
PATHRC = .;
DEBUGLIBPATH = $(BCB)\lib\debug
RELEASELIBPATH = $(BCB)\lib\release
USERDEFINES =
SYSDEFINES = _RTLDLL;NO_STRICT;USEPACKAGES
# ---------------------------------------------------------------------------
CFLAG1 = -I$(BCB)\include;$(BCB)\include\vcl;"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\";"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\" -Od -Hc -H=$(BCB)\lib\vcl40.csm -w -Ve -r- \
  -a8 -k -y -v -vi- -c -b- -w-par -w-inl -Vx -tW -tWM \
  -D$(SYSDEFINES);$(USERDEFINES)
IDLCFLAGS = -I$(BCB)\include -I$(BCB)\include\vcl -I"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\"; -I"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\"; -src_suffixcpp
PFLAGS = -U"..\..\..\..\..\Lib\C++ Builder 4";"..\..\..\Lib\C++ Builder 4";"..\..\..\..\..\..\Accuracer\Lib\C++ Builder 4";$(BCB)\lib\obj;$(BCB)\lib;"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\";"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\";$(RELEASELIBPATH) \
  -I$(BCB)\include;$(BCB)\include\vcl;"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\";"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\" -$YD -$W -$O- -v -JPHNE -M
RFLAGS = -i$(BCB)\include;$(BCB)\include\vcl;"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\";"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\"
AFLAGS = /i$(BCB)\include /i$(BCB)\include\vcl /i"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\"; /i"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\"; /mx /w2 /zd
LFLAGS = -L"..\..\..\..\..\Lib\C++ Builder 4";"..\..\..\Lib\C++ Builder 4";"..\..\..\..\..\..\Accuracer\Lib\C++ Builder 4";$(BCB)\lib\obj;$(BCB)\lib;"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\";"s:\AidAim\MsgCommunicator\DatabasePack\Lib\C++ Builder 4\";$(RELEASELIBPATH) \
  -aa -Tpe -x -Gn -v
# ---------------------------------------------------------------------------
ALLOBJ = c0w32.obj Memmgr.Lib $(PACKAGES) sysinit.obj $(OBJFILES)
ALLRES = $(RESFILES)
ALLLIB = $(LIBFILES) $(LIBRARIES) import32.lib cp32mti.lib
# ---------------------------------------------------------------------------
