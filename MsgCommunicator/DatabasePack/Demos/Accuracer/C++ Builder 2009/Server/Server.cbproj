	<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
		<PropertyGroup>
			<ProjectGuid>{7EE42F3F-9495-4DE6-9D94-BD2A3E54A2BF}</ProjectGuid>
			<ProjectType>CppVCLApplication</ProjectType>
			<MainSource>Server.cpp</MainSource>
			<Config Condition="'$(Config)'==''">Debug</Config>
			<ProjectVersion>12.0</ProjectVersion>
		</PropertyGroup>
		<PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
			<Base>true</Base>
		</PropertyGroup>
		<PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
			<Cfg_1>true</Cfg_1>
			<CfgParent>Base</CfgParent>
			<Base>true</Base>
		</PropertyGroup>
		<PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
			<Cfg_2>true</Cfg_2>
			<CfgParent>Base</CfgParent>
			<Base>true</Base>
		</PropertyGroup>
		<PropertyGroup Condition="'$(Base)'!=''">
			<LinkPackageStatics>rtl.lib;vcl.lib;vclMsgComd12.lib;vclx.lib;dbrtl.lib;vcldb.lib;bdertl.lib;VCLACCURACERd12.lib;MsgComDBACRd12.lib;xmlrtl.lib;vclactnband.lib</LinkPackageStatics>
			<BRCC_Defines>_RTLDLL;NO_STRICT;_VIS_NOLIB;$(BRCC_Defines)</BRCC_Defines>
			<PackageImports>rtl.bpi;vcl.bpi;vclx.bpi;vcljpg.bpi;dsnap.bpi;dbrtl.bpi;vcldb.bpi;bdertl.bpi;vclMsgComd12.bpi;vclAccuracerd12.bpi;MsgComDBACRd12.bpi</PackageImports>
			<ILINK_FullDebugInfo>true</ILINK_FullDebugInfo>
			<TASM_Defines>_RTLDLL;NO_STRICT;_VIS_NOLIB;$(TASM_Defines)</TASM_Defines>
			<DCC_CBuilderOutput>JPHNE</DCC_CBuilderOutput>
			<DCC_UnitSearchPath>.\;$(BDS)\lib;$(BDS)\lib\obj;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
			<ILINK_AppType>Windows</ILINK_AppType>
			<BRCC_UserSuppliedOptions> -I$(BDS)\include;$(BDS)\include\vcl;$(BDS)\include\dinkumware</BRCC_UserSuppliedOptions>
			<BRCC_IncludePath>$(BDS)\include;$(BDS)\include\vcl;$(BDS)\include\dinkumware;$(BRCC_IncludePath)</BRCC_IncludePath>
			<BCC_SourceDebuggingOn>true</BCC_SourceDebuggingOn>
			<BCC_IncludePath>$(BDS)\include;$(BDS)\include\vcl;$(BDS)\include\dinkumware;$(BCC_IncludePath)</BCC_IncludePath>
			<BCC_PCHCache>true</BCC_PCHCache>
			<DCC_IncludePath>.\;$(BDS)\lib;$(BDS)\lib\obj;$(DCC_IncludePath)</DCC_IncludePath>
			<TASM_IncludePath>$(BDS)\include;$(BDS)\include\vcl;$(BDS)\include\dinkumware;$(TASM_IncludePath)</TASM_IncludePath>
			<FinalOutputDir>.</FinalOutputDir>
			<BCC_GenerateWindowsApp>true</BCC_GenerateWindowsApp>
			<OutputExt>exe</OutputExt>
			<BCC_DisableOptimizations>true</BCC_DisableOptimizations>
			<TASM_AdditionalSwitches> /w2</TASM_AdditionalSwitches>
			<AllPackageLibs>rtl.lib;vcl.lib;vclMsgComd12.lib;vclx.lib;dbrtl.lib;vcldb.lib;bdertl.lib;VCLACCURACERd12.lib;MsgComDBACRd12.lib;xmlrtl.lib;vclactnband.lib</AllPackageLibs>
			<BCC_GenerateMultithreaded>true</BCC_GenerateMultithreaded>
			<ILINK_LibraryPath>..\..\..\Lib\Delphi and C++ Builder 2009 for Win32;..\..\..\..\..\Lib\Delphi and C++ Builder 2009 for Win32;..\..\..\..\..\..\Accuracer\Lib\Delphi and C++ Builder 2009 for Win32;$(BDS)\lib\obj;$(BDS)\lib;$(ILINK_LibraryPath)</ILINK_LibraryPath>
			<BCC_UserSuppliedOptions> -Vx -r- -k -Ve</BCC_UserSuppliedOptions>
			<BCC_Defines>NO_STRICT;_VIS_NOLIB;$(BCC_Defines)</BCC_Defines>
			<Multithreaded>true</Multithreaded>
			<DynamicRTL>true</DynamicRTL>
			<BCC_InlineFunctionExpansion>false</BCC_InlineFunctionExpansion>
			<BCC_DebugLineNumbers>true</BCC_DebugLineNumbers>
		</PropertyGroup>
		<PropertyGroup Condition="'$(Cfg_1)'!=''">
			<BCC_Defines>_DEBUG;$(BCC_Defines);$(BCC_Defines)</BCC_Defines>
			<ILINK_LibraryPath>$(BDS)\lib\debug;$(ILINK_LibraryPath);$(ILINK_LibraryPath)</ILINK_LibraryPath>
			<IntermediateOutputDir>Debug_Build</IntermediateOutputDir>
			<DCC_Define>DEBUG;$(DCC_Define);$(DCC_Define)</DCC_Define>
			<TASM_DisplaySourceLines>true</TASM_DisplaySourceLines>
			<ILINK_DisableIncrementalLinking>true</ILINK_DisableIncrementalLinking>
			<TASM_Debugging>Full</TASM_Debugging>
			<DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
			<DCC_AdditionalSwitches> -V</DCC_AdditionalSwitches>
		</PropertyGroup>
		<PropertyGroup Condition="'$(Cfg_2)'!=''">
			<BCC_Defines>NDEBUG;$(BCC_Defines);$(BCC_Defines)</BCC_Defines>
			<BCC_UserSuppliedOptions> -Vx -r- -k -Ve -r</BCC_UserSuppliedOptions>
			<BCC_OptimizeForSpeed>true</BCC_OptimizeForSpeed>
			<IntermediateOutputDir>Release_Build</IntermediateOutputDir>
			<DCC_AdditionalSwitches> -$O+</DCC_AdditionalSwitches>
			<TASM_Debugging>None</TASM_Debugging>
			<ILINK_LibraryPath>$(BDS)\lib\release;$(ILINK_LibraryPath);$(ILINK_LibraryPath)</ILINK_LibraryPath>
			<BCC_InlineFunctionExpansion>true</BCC_InlineFunctionExpansion>
		</PropertyGroup>
		<ItemGroup>
			<CppCompile Include="Server.cpp">
				<BuildOrder>-1</BuildOrder>
				<BuildOrder>0</BuildOrder>
			</CppCompile>
			<ResFiles Include="Server.res">
				<BuildOrder>-1</BuildOrder>
				<BuildOrder>1</BuildOrder>
			</ResFiles>
			<CppCompile Include="uMain.cpp">
				<BuildOrder>2</BuildOrder>
				<Form>fmMain</Form>
				<DependentOn>uMain.h</DependentOn>
				<BuildOrder>0</BuildOrder>
			</CppCompile>
			<FormResources Include="uMain.dfm"/>
			<BuildConfiguration Include="Base">
				<Key>Base</Key>
			</BuildConfiguration>
			<BuildConfiguration Include="Release">
				<Key>Cfg_2</Key>
				<CfgParent>Base</CfgParent>
			</BuildConfiguration>
			<BuildConfiguration Include="Debug">
				<Key>Cfg_1</Key>
				<CfgParent>Base</CfgParent>
			</BuildConfiguration>
		</ItemGroup>
		<Import Project="$(BDS)\Bin\CodeGear.Cpp.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Cpp.Targets')"/>
		<ProjectExtensions>
			<Borland.Personality>CPlusPlusBuilder.Personality.12</Borland.Personality>
			<Borland.ProjectType>CppVCLApplication</Borland.ProjectType>
			<BorlandProject>
				<CPlusPlusBuilder.Personality>
					<VersionInfo>
						<VersionInfo Name="IncludeVerInfo">False</VersionInfo>
						<VersionInfo Name="AutoIncBuild">False</VersionInfo>
						<VersionInfo Name="MajorVer">1</VersionInfo>
						<VersionInfo Name="MinorVer">0</VersionInfo>
						<VersionInfo Name="Release">0</VersionInfo>
						<VersionInfo Name="Build">0</VersionInfo>
						<VersionInfo Name="Debug">False</VersionInfo>
						<VersionInfo Name="PreRelease">False</VersionInfo>
						<VersionInfo Name="Special">False</VersionInfo>
						<VersionInfo Name="Private">False</VersionInfo>
						<VersionInfo Name="DLL">False</VersionInfo>
						<VersionInfo Name="Locale">1033</VersionInfo>
						<VersionInfo Name="CodePage">1262</VersionInfo>
					</VersionInfo>
					<VersionInfoKeys>
						<VersionInfoKeys Name="CompanyName"/>
						<VersionInfoKeys Name="FileDescription"/>
						<VersionInfoKeys Name="FileVersion">1.0.0.0</VersionInfoKeys>
						<VersionInfoKeys Name="InternalName"/>
						<VersionInfoKeys Name="LegalCopyright"/>
