package MsgComDBParadoxd7;

{$R *.res}
{$R 'MsgDatabaseParadox.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'AidAim MsgCommunicator Paradox Database Module'}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vclMsgComD7,
  bdertl,
  designide,
  dbrtl,
  vcl;

contains
  MsgDatabaseParadoxReg in 'MsgDatabaseParadoxReg.pas',
  MsgDatabaseParadox in 'MsgDatabaseParadox.pas';

end.
