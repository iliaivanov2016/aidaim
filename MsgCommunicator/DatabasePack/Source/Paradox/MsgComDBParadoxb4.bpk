# ---------------------------------------------------------------------------
!if !$d(BCB)
BCB = $(MAKEDIR)\..
!endif

# ---------------------------------------------------------------------------
# IDE SECTION
# ---------------------------------------------------------------------------
# The following section of the project makefile is managed by the BCB IDE.
# It is recommended to use the IDE to change any of the values in this
# section.
# ---------------------------------------------------------------------------

VERSION = BCB.04.04
# ---------------------------------------------------------------------------
PROJECT = MsgComDBACRb4.bpl
OBJFILES = MsgDatabaseAccuracer.obj MsgDatabaseAccuracerReg.obj MsgComDBACRb4.obj
RESFILES = MsgComDBACRb4.res MsgDatabaseAccuracer.dcr
RESDEPEN = $(RESFILES)
LIBFILES =
IDLFILES =
IDLGENFILES =
LIBRARIES =
SPARELIBS = Vcl40.lib vclMsgComB4.lib vclAccuracerb4.lib
PACKAGES = vcl40.bpi vclAccuracerb4.bpi vclMsgComB4.bpi vcldb40.bpi
DEFFILE =
# ---------------------------------------------------------------------------
PATHCPP = .;
PATHASM = .;
PATHPAS = .;
PATHRC = .;
DEBUGLIBPATH = $(BCB)\lib\debug
RELEASELIBPATH = $(BCB)\lib\release
USERDEFINES =
SYSDEFINES = _RTLDLL;NO_STRICT;USEPACKAGES
# ---------------------------------------------------------------------------
CFLAG1 = -I$(BCB)\include;$(BCB)\include\vcl;..\..\..\..\Accuracer\Current;..\..\..\Current \
  -Od -Hc -H=$(BCB)\lib\vcl40.csm -w -Ve -a8 -k- -vi -c -b- -w-par -w-inl -Vx \
  -tWM -D$(SYSDEFINES);$(USERDEFINES)
IDLCFLAGS = -I$(BCB)\include -I$(BCB)\include\vcl -I..\..\..\..\Accuracer\Current \
  -I..\..\..\Current -src_suffixcpp
PFLAGS = -UC:\compilers\CBuilder4\Lib\Release\;C:\compilers\CBuilder4\Projects\Lib\;F:\Compilers\CBuilder4\Projects\Lib\;f:\compilers\cbuilder4\lib\release\;$(BCB)\lib\obj;$(BCB)\lib;..\..\..\..\Accuracer\Current;..\..\..\Current;$(RELEASELIBPATH) \
  -I$(BCB)\include;$(BCB)\include\vcl;..\..\..\..\Accuracer\Current;..\..\..\Current \
  -$Y- -$L- -$D- -v -JPHNE -M
RFLAGS = -i$(BCB)\include;$(BCB)\include\vcl;..\..\..\..\Accuracer\Current;..\..\..\Current
AFLAGS = /i$(BCB)\include /i$(BCB)\include\vcl /i..\..\..\..\Accuracer\Current \
  /i"S:\Projects\Delphi Components\MsgCommunicator\Current" /mx /w2 /zn
LFLAGS = -LC:\compilers\CBuilder4\Lib\Release\;C:\compilers\CBuilder4\Projects\Lib\;F:\Compilers\CBuilder4\Projects\Lib\;f:\compilers\cbuilder4\lib\release\;$(BCB)\lib\obj;$(BCB)\lib;..\..\..\..\Accuracer\Current;..\..\..\Current;$(RELEASELIBPATH) \
  -D"AidAim MsgCommunicator Accuracer Database Module" -aa -Tpp -Gpd -x -Gn -Gl -Gi
# ---------------------------------------------------------------------------
ALLOBJ = c0pkg32.obj Memmgr.Lib $(PACKAGES) sysinit.obj $(OBJFILES)
ALLRES = $(RESFILES)
ALLLIB = $(LIBFILES) $(LIBRARIES) import32.lib cp32mti.lib
# ---------------------------------------------------------------------------
!ifdef IDEOPTIONS

[Version Info]
IncludeVerInfo=1
AutoIncBuild=0
MajorVer=1
MinorVer=0
Release=0
Build=0
