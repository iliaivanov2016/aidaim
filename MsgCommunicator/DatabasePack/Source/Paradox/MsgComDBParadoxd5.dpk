package MsgComDBParadoxd5;

{$R *.RES}
{$R 'MsgDatabaseParadox.dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'AidAim MsgCommunicator Paradox Database Module'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  vclMsgComD5,
  vclParadoxd5;

contains
  MsgDatabaseParadoxReg in 'MsgDatabaseParadoxReg.pas',
  MsgDatabaseParadox in 'MsgDatabaseParadox.pas';

end.
