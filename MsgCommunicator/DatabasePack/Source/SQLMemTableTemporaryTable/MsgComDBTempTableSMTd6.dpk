package MsgComDBTempTableSMTd6;

{$R *.res}
{$R 'MsgDatabaseTempTableSQLMemTable.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'AidAim MsgCommunicator Database Temporary Table Component via SQLMemTable'}
{$IMPLICITBUILD OFF}

requires
  vcl,
  vclx,
  vcldb,
  vclMsgComD6,
  vclSQLMemTabled6,
  designide;

contains
  MsgDatabaseTempTableSQLMemTableReg in 'MsgDatabaseTempTableSQLMemTableReg.pas',
  MsgDatabaseTempTableSQLMemTable in 'MsgDatabaseTempTableSQLMemTable.pas';

end.
