package MsgComDBMySQLd14;

{$R *.res}
{$R 'MsgDatabaseMySQL.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'AidAim MsgCommunicator MySQL Database module (BDE, ODBC and dbExpress)'}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vclMsgComd14,
  designide,
  dbrtl,
  vcl,
  bdertl
//,  dbexpress
;

contains
  MsgDatabaseMySQLReg in 'MsgDatabaseMySQLReg.pas',
  MsgDatabaseMySQL in 'MsgDatabaseMySQL.pas';

end.
