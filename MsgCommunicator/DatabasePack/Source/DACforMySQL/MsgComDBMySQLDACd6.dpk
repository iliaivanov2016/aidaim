package MsgComDBMySQLDACd6;

{$R *.res}
{$R 'MsgDatabaseMySQLDAC.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'AidAim MsgCommunicator DAC for mySQL Database Module'}
{$IMPLICITBUILD OFF}

requires
  vcl,
  vclx,
  vcldb,
  vclMsgComD6,
  designide,
  mySQLDAC6;

contains
  MsgDatabaseMySQLDACReg in 'MsgDatabaseMySQLDACReg.pas',
  MsgDatabaseMySQLDAC in 'MsgDatabaseMySQLDAC.pas';

end.
