package MsgComDBMySQLDACd11;

{$R *.res}
{$R 'MsgDatabaseMySQLDAC.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'AidAim MsgCommunicator DAC for mySQL Database Module'}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vclMsgComD11,
  designide,
  dbrtl,
  vcl,
  vcldb,
  mySQLDAC11;

contains
  MsgDatabaseMySQLDACReg in 'MsgDatabaseMySQLDACReg.pas',
  MsgDatabaseMySQLDAC in 'MsgDatabaseMySQLDAC.pas';

end.
