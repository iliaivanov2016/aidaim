package MsgComDBACRd14;

{$R *.res}
{$R 'MsgDatabaseAccuracer.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'AidAim MsgCommunicator Accuracer Database Module'}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vclMsgComd14,
  vclAccuracerd14,
  designide,
  dbrtl,
  vcl;

contains
  MsgDatabaseAccuracerReg in 'MsgDatabaseAccuracerReg.pas',
  MsgDatabaseAccuracer in 'MsgDatabaseAccuracer.pas';

end.
