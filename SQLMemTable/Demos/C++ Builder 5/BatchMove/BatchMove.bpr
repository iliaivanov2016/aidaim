[Excluded Packages]
$(BCB)\Bin\mfcowlwizard.bpl=MFC/OWL Wizard

[Debugging]
DebugSourceDirs=$(BCB)\source\vcl

[Parameters]
RunParams=
HostApplication=
RemoteHost=
RemotePath=
RemoteDebug=0

[Compiler]
