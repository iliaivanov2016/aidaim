Item1=$(BCB)\include;$(BCB)\include\vcl

[HistoryLists\hlLibraryPath]
Count=3
Item0=lib;$(BCB)\lib\obj;$(BCB)\lib;E:\AidAim\Accuracer320_cs_pro.b4\Lib\C++ Builder 4\;..\..\..\Work_SQLMem
Item1=lib;$(BCB)\lib\obj;$(BCB)\lib;E:\AidAim\Accuracer320_cs_pro.b4\Lib\C++ Builder 4\;S:\Projects\Delphi Components\Accuracer\Work_SQLMem
Item2=$(BCB)\lib\obj;$(BCB)\lib;E:\AidAim\Accuracer320_cs_pro.b4\Lib\C++ Builder 4

