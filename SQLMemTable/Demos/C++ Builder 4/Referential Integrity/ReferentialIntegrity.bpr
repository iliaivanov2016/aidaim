# ---------------------------------------------------------------------------
!if !$d(BCB)
BCB = $(MAKEDIR)\..
!endif

# ---------------------------------------------------------------------------
# IDE SECTION
# ---------------------------------------------------------------------------
# The following section of the project makefile is managed by the BCB IDE.
# It is recommended to use the IDE to change any of the values in this
# section.
# ---------------------------------------------------------------------------

VERSION = BCB.04.04
# ---------------------------------------------------------------------------
PROJECT = ReferentialIntegrity.exe
OBJFILES = ReferentialIntegrity.obj uMain.obj
RESFILES = ReferentialIntegrity.res
RESDEPEN = $(RESFILES) uMain.dfm
LIBFILES =
IDLGENFILES =
IDLFILES =
LIBRARIES = vclSQLMemTableb4.lib
SPARELIBS = Vcl40.lib Vcldb40.lib vclSQLMemTableb4.lib
PACKAGES = Vcl40.bpi Vclx40.bpi vcljpg40.bpi Vclmid40.bpi Vcldb40.bpi
DEFFILE =
# ---------------------------------------------------------------------------
PATHCPP = .;
PATHPAS = .;
PATHASM = .;
PATHRC = .;
DEBUGLIBPATH = $(BCB)\lib\debug
RELEASELIBPATH = $(BCB)\lib\release
USERDEFINES =
SYSDEFINES = _RTLDLL;NO_STRICT;USEPACKAGES
# ---------------------------------------------------------------------------
CFLAG1 = -I$(BCB)\include;$(BCB)\include\vcl;..\..\..\Work_SQLMem -Od -Hc \
  -H=$(BCB)\lib\vcl40.csm -w -Ve -r- -a8 -k -y -v -vi- -c -b- -w-par -w-inl -Vx \
  -tW -tWM -D$(SYSDEFINES);$(USERDEFINES)
IDLCFLAGS = -I$(BCB)\include -I$(BCB)\include\vcl -I..\..\..\Work_SQLMem -src_suffixcpp
PFLAGS = -Ulib;$(BCB)\lib\obj;$(BCB)\lib;"E:\AidAim\Accuracer320_cs_pro.b4\Lib\C++ Builder 4\";..\..\..\Work_SQLMem;$(RELEASELIBPATH) \
  -I$(BCB)\include;$(BCB)\include\vcl;..\..\..\Work_SQLMem -$YD -$W -$O- -v \
  -JPHNE -M
RFLAGS = -i$(BCB)\include;$(BCB)\include\vcl;..\..\..\Work_SQLMem
AFLAGS = /i$(BCB)\include /i$(BCB)\include\vcl /i..\..\..\Work_SQLMem /mx /w2 /zd
LFLAGS = -Llib;$(BCB)\lib\obj;$(BCB)\lib;"E:\AidAim\Accuracer320_cs_pro.b4\Lib\C++ Builder 4\";..\..\..\Work_SQLMem;$(RELEASELIBPATH) \
  -aa -Tpe -x -Gn -v
# ---------------------------------------------------------------------------
ALLOBJ = c0w32.obj Memmgr.Lib $(PACKAGES) sysinit.obj $(OBJFILES)
ALLRES = $(RESFILES)
ALLLIB = $(LIBFILES) $(LIBRARIES) import32.lib cp32mti.lib
# ---------------------------------------------------------------------------
